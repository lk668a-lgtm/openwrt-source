#!/bin/sh /etc/rc.common
# 自愈守护的看护进程。
# 背景：watchdog.sh 自己负责拉 xray / DNS 桥 / 补路由，但它本身没有任何东西看护——
# 被 OOM 或误杀之后，DNS 桥再挂就没人救，客户表现是「WiFi 连上、网页全打不开」，
# 只能重启路由器。这里用 procd 托管，死掉 5 秒重拉，退出码非 0 也重拉。
START=99
STOP=10
USE_PROCD=1

start_service() {
	[ -x /usr/libexec/tkproxy/watchdog.sh ] || return 0
	procd_open_instance
	procd_set_param command /bin/sh /usr/libexec/tkproxy/watchdog.sh
	procd_set_param respawn 3600 5 5
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance
}

reload_service() {
	start_service
}
