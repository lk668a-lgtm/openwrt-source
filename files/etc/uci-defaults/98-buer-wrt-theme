#!/bin/sh
# BUERWRT 默认外观：Argon 主题 + 深色模式（卡 t_c17f7470）
#
# 字段依据（取自 vendor 进本仓库的主题源码 packages-vendor/luci-theme-argon/，版本 3.1.2）：
# - 主题名：luci.themes.Argon=/luci-static/argon
#   （root/etc/uci-defaults/30_luci-theme-argon 中主题自己就这样注册）
# - 深色模式：argon.@global[0].mode='dark'，值域 normal|light|dark
#   （ucode/template/themes/argon/head.ut 第 92-94 行：只认 normal/dark/light；
#    root/usr/libexec/rpcd/luci.argon_appearance 的 set 也只接受这三个值并写回此字段）
#   注意：没有 luci.main.darkmode 这个字段——那是老版 argon 的写法，3.x 不支持。
#
# 本脚本只在首次开机（uci-defaults）时跑一次；用户之后的修改不会被覆盖。

# 1) 默认主题 = argon（仅当该键不存在时才设置，尊重用户/上游已有选择）
# 出厂默认是 bootstrap；用户自己选过别的主题（不是 bootstrap）就尊重不动
_cur_theme="$(uci -q get luci.main.mediaurlbase)"
if [ -z "$_cur_theme" ] || [ "$_cur_theme" = "/luci-static/bootstrap" ]; then
	uci set luci.main.mediaurlbase='/luci-static/argon'
fi

# 2) 确保 themes 列表里有 Argon（重复设置无害）
if ! uci -q get luci.themes.Argon >/dev/null; then
	uci set luci.themes.Argon='/luci-static/argon'
fi

# 3) 默认深色模式：写 /etc/config/argon 的 mode 字段。
#    argon 配置文件由主题包的 30_luci-theme-argon 创建（99- 排在其后，时序保证
#    节与默认值已就位；若没有则自己补出 @global[0] 节兜底）。
#    只在「字段缺失或仍是主题默认 normal」时才写 dark：
#    sysupgrade 保配置升级后 uci-defaults 会重放，用户已改成 light/dark 的
#    选择不能被覆盖；全新刷机时是 normal，落到 dark。
if ! uci -q get argon.@global[0] >/dev/null; then
	touch /etc/config/argon
	uci -q add argon global >/dev/null
fi
current_mode="$(uci -q get argon.@global[0].mode)"
if [ -z "$current_mode" ] || [ "$current_mode" = "normal" ]; then
	uci -q set argon.@global[0].mode='dark'
fi
uci -q commit argon

uci -q commit luci

exit 0
